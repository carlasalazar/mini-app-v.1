:root {
  --sky-blue: #87CEEB;
  --light-green: #D4E5D9;
  --teal-dark: #0B6E56;
  --teal-light: #7FCEBC;
  --grass-green: #4A7C59;
  --pink: #FF6B9D;
  --soft-yellow: #FFE680;
  --glass: rgba(255, 255, 255, 0.70);
  --white: #FFFFFF;
}

page {
  background: linear-gradient(180deg, #87CEEB 0%, #D4E5D9 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  color: #0B6E56;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

view, text {
  box-sizing: border-box;
}

/* Common UI Utilities (replaces some Tailwind basics) */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.items-center { align-items: center; }
.justify-center { justify-content: center; }
.flex-1 { flex: 1; }
.w-full { width: 100%; }
.h-full { height: 100%; }
.relative { position: relative; }
.absolute { position: absolute; }
.overflow-hidden { overflow: hidden; }

/* Animation Keyframes (to replace Framer Motion basics) */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { transform: translateY(50rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.animate-fade-in {
  animation: fadeIn 0.3s ease-out forwards;
}

.animate-slide-up {
  animation: slideUp 0.4s ease-out forwards;
}


/* ===============================
   CUSTOM TAB BAR
   =============================== */
   .custom-tab-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 90px; /* Aquí controlas el alto total de la barra */
    background-color: #59A5C6;
    display: flex;
    justify-content: space-around;
    align-items: center;
    z-index: 9999;
    padding-bottom: 15px; /* Espacio extra para los celulares sin botones físicos */
    box-shadow: 0px -2px 10px rgba(0,0,0,0.1);
  }
  
  .tab-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 25%;
  }

  
  .tab-text {
    font-size: 14px; /* ¡AQUÍ CRECES EL TEXTO! */
    color: #FFFFFF;
  }
  
  .tab-text.active {
    color: #0B6E56;
    font-weight: bold;
  }

  .tab-icon {
    width: 38px;
    height: 38px;
    margin-bottom: 4px;
    /* Ahora los inactivos tendrán su color normal */
    filter: grayscale(0%) opacity(100%); 
    transition: all 0.3s ease;
  }
  
  /* El ícono seleccionado (activo) se vuelve gris */
  .tab-icon.active {
    filter: grayscale(100%) opacity(60%);
  }



  /* ===============================
   CUSTOM HEADER (Títulos)
   =============================== */
   .custom-header {
    width: 100%;
    height: 60px;
    background-color: #59A5C6;
    display: flex;
    justify-content: flex-start; /* Sigue alineado al inicio */
    align-items: center;
    
    /* Esto lo coloca justo en la mitad de la mitad izquierda (25% del total) */
    padding-left: 10%; 
    
    box-sizing: border-box; /* Vital para que no se desfase el ancho */
    box-shadow: 0px 4px 6px rgba(0,0,0,0.1);
  }

/* OPCIÓN A: Si vas a usar texto */
.header-texto {
  color: #FFFFFF;
  font-size: 24px;
  font-weight: bold;
  /* Aquí puedes intentar poner tu fuente, aunque en Mini Apps suele ser complejo sin una URL externa */
  font-family: 'Arial', sans-serif; 
}

/* OPCIÓN B: Si hiciste el título como imagen/logo (Recomendado) */
.header-imagen {
  height: 40px;
  width: 150px;
}

