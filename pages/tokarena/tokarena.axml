<view class="page-container" style="background-color: {{ARENA.bgDeep}}; color: {{ARENA.textPri}};">
  
  <!-- HEADER -->
  <view class="header">
    <view class="header-left">
      <view a:if="{{view !== 'base' && view !== 'escape'}}" onTap="setView" data-view="base" class="back-btn">
        <text class="icon" style="color: {{ARENA.accentFire}};">←</text>
      </view>
      <text class="icon-swords" style="color: {{ARENA.accentFire}};">⚔️</text>
      <text class="title">Tokarena</text>
    </view>
    <view class="header-right" style="background-color: {{ARENA.bgCard}}; border-color: {{ARENA.border}};">
      <text class="icon-shield" style="color: {{healthColor}};">🛡️</text>
      <text class="health-text" style="color: {{healthColor}};">{{protectionLevel}} Prot</text>
    </view>
  </view>

  <view class="content">
    
    <!-- VISTA BASE -->
    <view a:if="{{view === 'base'}}" class="view-base animate-fade-in">
      <view class="center-area">
        <!-- Health Bar -->
        <view class="health-bar-bg" style="background-color: {{ARENA.bgCard}};">
          <view class="health-bar-fill" style="width: {{healthPct}}%; background-color: {{healthColor}};"></view>
        </view>

        <!-- Ring & Tokayito -->
        <view class="avatar-ring">
          <view class="ring-outer {{healthPct > 30 ? 'vio' : 'danger'}}" style="border-color: {{healthPct > 30 ? ARENA.accentVio : ARENA.danger}};"></view>
          <view class="tokayito-box" style="background-color: {{ARENA.bgCard}}; border-color: {{ARENA.accentVio}};">
            <!-- Base flotante pixelada del fuerte -->
            <view class="fuerte-contenedor">

              <!-- Superficie superior de la isla (el pasto) -->
              <view class="isla-superficie">
                <!-- Píxeles decorativos del borde superior -->
                <view class="pixel-deco pixel-deco-1"></view>
                <view class="pixel-deco pixel-deco-2"></view>
                <view class="pixel-deco pixel-deco-3"></view>
                <view class="pixel-deco pixel-deco-4"></view>
                <!-- Área donde irán Tokayito y los bloques -->
                <view class="isla-plataforma">
                  <!-- Bloques lado izquierdo -->
                  <view class="bloques-columna bloques-izquierda">
                    <view
                      a:for="{{bloquesIzquierda}}"
                      a:key="id"
                      class="bloque-wrapper"
                    >
                      <image
                        class="bloque-img"
                        src="{{rutaBloqueNube}}"
                        mode="aspectFit"
                      />
                    </view>
                  </view>

                  <!-- Tokayito centrado -->
                  <view class="tokayito-wrapper">
                    <image
                      class="tokayito-img"
                      src="{{rutaTokayito}}"
                      mode="aspectFit"
                    />
                  </view>

                  <!-- Bloques lado derecho -->
                  <view class="bloques-columna bloques-derecha">
                    <view
                      a:for="{{bloquesDerecha}}"
                      a:key="id"
                      class="bloque-wrapper"
                    >
                      <image
                        class="bloque-img"
                        src="{{rutaBloqueMadera}}"
                        mode="aspectFit"
                      />
                    </view>
                  </view>
                </view>
              </view>

              <!-- Cuerpo de tierra que cuelga hacia abajo -->
              <view class="isla-tierra">
                <view class="tierra-capa-1"></view>
                <view class="tierra-capa-2"></view>
                <!-- Picos de tierra colgando -->
                <view class="tierra-picos">
                  <view class="pico pico-1"></view>
                  <view class="pico pico-2"></view>
                  <view class="pico pico-3"></view>
                  <view class="pico pico-4"></view>
                  <view class="pico pico-5"></view>
                </view>
              </view>

              <!-- Sombra proyectada debajo de la isla -->
              <view class="isla-sombra"></view>

            </view>
          </view>
        </view>

        <!-- Grid de jugadores -->
        <view class="grid-jugadores">
          <view
            a:for="{{mockUsers}}"
            a:key="id"
            class="grid-item"
          >
            <!-- Base flotante pixelada del jugador -->
            <view class="isla-mini">
              <!-- Superficie de la isla -->
              <view class="isla-mini-superficie">
                <view class="isla-mini-plataforma"></view>
              </view>
              <!-- Tierra colgando -->
              <view class="isla-mini-tierra">
                <view class="tierra-mini-capa-1"></view>
                <view class="tierra-mini-capa-2"></view>
                <view class="tierra-mini-picos">
                  <view class="pico-mini pico-mini-1"></view>
                  <view class="pico-mini pico-mini-2"></view>
                  <view class="pico-mini pico-mini-3"></view>
                </view>
              </view>
              <!-- Sombra -->
              <view class="isla-mini-sombra"></view>
            </view>
            <!-- Nombre del jugador -->
            <text class="grid-jugador-nombre">{{item.user}}</text>
          </view>
        </view>
      </view>

      <!-- Action Buttons -->
      <view class="action-footer">
        <view onTap="toggleInventory" class="action-btn outline" style="background-color: {{ARENA.bgCard}}; border-color: {{ARENA.accentVio}};">
          <text class="icon-btn" style="color: {{ARENA.accentVio}};">🔨</text>
          <text class="label-btn">Construir</text>
        </view>
        <view onTap="toggleExplorar" class="action-btn solid" style="background-color: {{ARENA.accentFire}};">
          <text class="icon-btn" style="color: #FFF;">⚔️</text>
          <text class="label-btn" style="color: #FFF;">Explorar</text>
        </view>
      </view>
    </view>

    <!-- EXPLORACION (BASE DE TOKAYOS) -->
    <view a:if="{{view === 'explorar'}}" class="view-explorar animate-slide-up">
      <view class="explorar-header">
        <text class="title-text">Base de Tokayos</text>
        <view class="search-box">
          <input class="search-input" placeholder="Buscar usuarios o amigos..." onInput="onSearchInput" value="{{searchQuery}}" />
        </view>
      </view>

      <scroll-view scroll-y class="user-list">
        <view class="section-subtitle">Añadir Amigos / Cercanos</view>
        <view a:for="{{mockUsers}}" class="user-card" style="background-color: {{ARENA.bgCard}}; border-color: {{ARENA.border}};">
          <view class="user-info">
            <view class="user-avatar-small">👤</view>
            <view class="user-meta">
              <text class="username">{{item.user}}</text>
              <view class="protection-tag" style="color: {{ARENA.accentVio}};">
                🛡️ Prot: {{item.protection}}
              </view>
            </view>
          </view>
          <view class="user-actions">
            <view class="btn-action donate" onTap="donarBloque" data-id="{{item.id}}">🎁 Donar</view>
            <view class="btn-action attack" onTap="iniciarAtaque" data-id="{{item.id}}">⚔️ Atacar</view>
          </view>
        </view>
      </scroll-view>

      <view class="close-footer" onTap="toggleExplorar">
        <text>Cerrar Exploración</text>
      </view>
    </view>

    <!-- ESCENA DE ATAQUE -->
    <view a:if="{{view === 'atacar'}}" class="view-atacar animate-fade-in">
      <view class="rival-info">
        <text class="rival-name">Atacando a {{rival.user}}</text>
        <view class="rival-stats">🛡️ {{rival.protection}}</view>
      </view>

      <view class="battle-arena">
        <view class="enemy-fort">
          <!-- Mocking blocks to "destroy" -->
          <view a:for="{{[1,2,3,4,5,6]}}" class="enemy-block animate-wiggle" onTap="atacarCubo">
            📦
          </view>
        </view>
      </view>

      <view class="attack-footer">
        <text class="attack-hint">¡Toca los bloques para destruirlos!</text>
        <view class="exit-btn" onTap="finalizarAtaque">Terminar Ataque</view>
      </view>
    </view>

    <!-- INVENTORY OVERLAY (DRAWER) -->
    <view a:if="{{showInventory}}" class="inventory-overlay">
      <view class="overlay-backdrop" onTap="toggleInventory"></view>
      <view class="inventory-drawer animate-slide-up">
        <view class="drawer-header">
          <view class="handle"></view>
          <view class="header-content">
            <text class="drawer-title">Mi Inventario</text>
            <view class="close-btn" onTap="toggleInventory">
              <text>×</text>
            </view>
          </view>
        </view>

        <scroll-view scroll-y class="inventory-scroll">
          <view class="inventory-grid">
            <view a:for="{{inventory}}" class="inventory-item" onTap="seleccionarBloque" data-id="{{item.id}}">
              <view class="item-card">
                <image src="{{item.img}}" class="item-img" mode="aspectFit" />
                <text class="item-qty">x{{item.qty}}</text>
                <view class="hardness-container">
                  <view class="hardness-bar">
                    <view class="hardness-fill" style="width: {{item.dureza}}%;"></view>
                  </view>
                  <text class="hardness-label">{{item.dureza}}</text>
                </view>
                <text class="item-name">{{item.nombre}}</text>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>

    <!-- ESCAPE (Game Over) -->
    <view a:if="{{view === 'escape'}}" class="view-escape animate-fade-in">
      <view class="alert-icon-box animate-pulse">
        <text class="icon-giant">⚠️</text>
      </view>
      <text class="escape-title">¡BASE DESTRUIDA!</text>
      <text class="escape-subtitle">Tu Tokayito escapó por el agujero. ¡Atrápalo!</text>
      
      <view onTap="atraparTokayo" class="catch-btn animate-float" style="background-color: {{ARENA.accentVio}}; border-color: {{ARENA.textPri}};">
        <text class="catch-emoji">🏃‍♂️</text>
      </view>
      <text class="catch-hint">¡Tócalo para atraparlo!</text>
    </view>

  </view>
</view>
