.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.header {
  padding: 64rpx 40rpx 40rpx;
  border-bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 10;
}

.header-left {
  display: flex;
  align-items: center;
}

.back-btn {
  margin-right: 16rpx;
}

.icon {
  font-size: 48rpx;
}

.icon-swords {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}

.header-right {
  display: flex;
  align-items: center;
  padding: 8rpx 24rpx;
  border-radius: 40rpx;
  border: 2rpx solid;
}

.icon-shield {
  font-size: 30rpx;
  margin-right: 8rx;
}

.health-text {
  font-size: 24rpx;
  font-weight: bold;
}

.content {
  flex: 1;
  position: relative;
  overflow: hidden;
}

/* VISTA BASE */
.view-base {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 32rpx;
}

.center-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.health-bar-bg {
  width: 448rpx;
  height: 16rpx;
  border-radius: 16rpx;
  margin-bottom: 48rpx;
  overflow: hidden;
}

.health-bar-fill {
  height: 100%;
  border-radius: 16rpx;
  transition: width 0.6s ease-out;
}

.avatar-ring {
  width: 384rpx;
  height: 384rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-outer {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 4rpx dashed;
  opacity: 0.5;
  animation: rotateRing 8s linear infinite;
}

@keyframes rotateRing {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.tokayito-box {
  width: 128rpx;
  height: 128rpx;
  border-radius: 32rpx;
  border: 4rpx solid;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 40rpx rgba(124, 58, 237, 0.3);
  animation: tokayitoFloat 2s ease-in-out infinite;
}

@keyframes tokayitoFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

.tokayito-emoji {
  font-size: 48rpx;
}

.status-msg {
  margin-top: 48rpx;
  font-size: 24rpx;
  text-align: center;
}

.debug-btn {
  margin-top: 24rpx;
  opacity: 0.4;
}

.debug-btn text {
  font-size: 24rpx;
  text-decoration: underline;
}

.action-footer {
  display: flex;
  gap: 32rpx;
  padding: 32rpx 0;
}

.action-btn {
  flex: 1;
  padding: 32rpx 0;
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.action-btn.outline {
  border: 2rpx solid;
}

.action-btn:active {
  transform: scale(0.95);
}

.icon-btn {
  font-size: 44rpx;
}

.label-btn {
  font-size: 24rpx;
  font-weight: bold;
}

/* CATALOGO */
.view-catalogo {
  position: absolute;
  inset: 0;
  background-color: var(--glass);
  backdrop-filter: blur(10px);
  padding: 32rpx;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.icon-title { font-size: 40rpx; }
.title-text { font-size: 36rpx; font-weight: bold; color: var(--teal-dark); }

.scroll-list { height: calc(100% - 80rpx); }

.catalogo-item {
  padding: 32rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 2rpx solid;
}

.item-info { display: flex; align-items: center; gap: 24rpx; }

.item-color-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  border: 4rpx solid rgba(255,255,255,0.2);
}

.item-text { display: flex; flex-direction: column; }

.item-name { font-size: 28rpx; font-weight: bold; color: var(--teal-dark); }
.item-stats { font-size: 24rpx; color: var(--grass-green); }

.buy-btn {
  padding: 12rpx 32rpx;
  border-radius: 40rpx;
  border: 2rpx solid;
}

.buy-label { font-size: 24rpx; font-weight: bold; color: #1A0800; }

/* ESCAPE */
.view-escape {
  position: absolute;
  inset: 0;
  background-color: #FF6B9D;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  text-align: center;
}

.icon-giant { font-size: 128rpx; }

.escape-title {
  font-size: 48rpx;
  font-weight: 900;
  margin-top: 32rpx;
  margin-bottom: 16rpx;
  color: #FF6B6B;
}

.escape-subtitle {
  font-size: 28rpx;
  margin-bottom: 64rpx;
}

.catch-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 8rpx solid;
}

.catch-emoji { font-size: 60rpx; }

.catch-hint {
  margin-top: 80rpx;
  font-size: 24rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}
.animate-pulse { animation: pulse 0.8s infinite; }

@keyframes floatMany {
  0% { transform: translate(-100rpx, -50rpx); }
  25% { transform: translate(100rpx, 50rpx); }
  50% { transform: translate(-50rpx, -80rpx); }
  75% { transform: translate(80rpx, 20rpx); }
  100% { transform: translate(0, 0); }
}
.animate-float { animation: floatMany 3s linear infinite; }
