.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.header {
  padding: 64rpx 40rpx 40rpx;
  border-bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 10;
}

.header-left {
  display: flex;
  align-items: center;
}

.back-btn {
  margin-right: 16rpx;
}

.icon {
  font-size: 48rpx;
}

.icon-swords {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}

.header-right {
  display: flex;
  align-items: center;
  padding: 8rpx 24rpx;
  border-radius: 40rpx;
  border: 2rpx solid;
}

.icon-shield {
  font-size: 30rpx;
  margin-right: 8rx;
}

.health-text {
  font-size: 24rpx;
  font-weight: bold;
}

.content {
  flex: 1;
  position: relative;
  overflow: hidden;
}

/* VISTA BASE */
.view-base {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 32rpx;
}

.center-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.health-bar-bg {
  width: 448rpx;
  height: 16rpx;
  border-radius: 16rpx;
  margin-bottom: 48rpx;
  overflow: hidden;
}

.health-bar-fill {
  height: 100%;
  border-radius: 16rpx;
  transition: width 0.6s ease-out;
}

.avatar-ring {
  width: 384rpx;
  height: 384rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-outer {
  position: absolute;
  inset: 0;
  opacity: 0.5;
  animation: rotateRing 8s linear infinite;
}

@keyframes rotateRing {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.tokayito-box {
  width: 128rpx;
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: tokayitoFloat 2s ease-in-out infinite;
}

@keyframes tokayitoFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

.tokayito-emoji {
  font-size: 48rpx;
}



.debug-btn {
  margin-top: 24rpx;
  opacity: 0.4;
}

.debug-btn text {
  font-size: 24rpx;
  text-decoration: underline;
}

.action-footer {
  display: flex;
  gap: 32rpx;
  padding: 32rpx 0;
}

.action-btn {
  flex: 1;
  padding: 32rpx 0;
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.action-btn.outline {
  border: 2rpx solid;
}

.action-btn:active {
  transform: scale(0.95);
}

.icon-btn {
  font-size: 44rpx;
}

.label-btn {
  font-size: 24rpx;
  font-weight: bold;
}

/* INVENTORY OVERLAY */
.inventory-overlay {
  position: absolute;
  inset: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.overlay-backdrop {
  position: absolute;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(4px);
}

.inventory-drawer {
  position: relative;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  border-top-left-radius: 64rpx;
  border-top-right-radius: 64rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.3);
  height: 70vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -20rpx 60rpx rgba(0, 0, 0, 0.1);
}

.drawer-header {
  padding: 24rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.handle {
  width: 80rpx;
  height: 8rpx;
  background-color: rgba(11, 110, 86, 0.2);
  border-radius: 4rpx;
  margin-bottom: 32rpx;
}

.header-content {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.drawer-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #0B6E56;
}

.close-btn {
  width: 64rpx;
  height: 64rpx;
  background-color: rgba(11, 110, 86, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-btn text {
  font-size: 40rpx;
  color: #0B6E56;
  line-height: 1;
}

.inventory-scroll {
  flex: 1;
  padding: 0 40rpx 40rpx;
}

.inventory-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
  padding-top: 20rpx;
}

.inventory-item {
  aspect-ratio: 1;
}

.item-card {
  height: 100%;
  background: rgba(255, 255, 255, 0.6);
  border: 2rpx solid rgba(127, 206, 188, 0.3);
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 16rpx;
  transition: all 0.2s ease;
}

.item-card:active {
  transform: scale(0.95);
  background: rgba(255, 255, 255, 0.9);
}

.item-img {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 24rpx;
}

.item-qty {
  position: absolute;
  top: 12rpx;
  right: 16rpx;
  font-size: 20rpx;
  font-weight: 900;
  color: #0B6E56;
}

.hardness-container {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.hardness-bar {
  flex: 1;
  height: 6rpx;
  background-color: rgba(11, 110, 86, 0.1);
  border-radius: 3rpx;
  overflow: hidden;
}

.hardness-fill {
  height: 100%;
  background: linear-gradient(90deg, #7FCEBC, #4A7C59);
  border-radius: 3rpx;
}

.hardness-label {
  font-size: 16rpx;
  font-weight: bold;
  color: #4A7C59;
  min-width: 24rpx;
}

.item-name {
  font-size: 20rpx;
  font-weight: 600;
  color: #0B6E56;
  text-align: center;
  opacity: 0.8;
}

/* ESCAPE */
.view-escape {
  position: absolute;
  inset: 0;
  background-color: #FF6B9D;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  text-align: center;
}

.icon-giant { font-size: 128rpx; }

.escape-title {
  font-size: 48rpx;
  font-weight: 900;
  margin-top: 32rpx;
  margin-bottom: 16rpx;
  color: #FF6B6B;
}

.escape-subtitle {
  font-size: 28rpx;
  margin-bottom: 64rpx;
}

.catch-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 8rpx solid;
}

.catch-emoji { font-size: 60rpx; }

.catch-hint {
  margin-top: 80rpx;
  font-size: 24rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

/* EXPLORACION (BASE DE TOKAYOS) */
.view-explorar {
  position: absolute;
  inset: 0;
  background-color: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px);
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  z-index: 50;
}

.explorar-header {
  margin-bottom: 40rpx;
}

.title-text {
  font-size: 44rpx;
  font-weight: 900;
  color: #0B6E56;
  display: block;
  margin-bottom: 24rpx;
}

.search-box {
  background: white;
  border-radius: 32rpx;
  padding: 8rpx 32rpx;
  border: 2rpx solid #7FCEBC;
}

.search-input {
  height: 80rpx;
  font-size: 28rpx;
}

.section-subtitle {
  font-size: 24rpx;
  font-weight: bold;
  color: #4A7C59;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  margin-bottom: 24rpx;
}

.user-card {
  padding: 32rpx;
  border-radius: 40rpx;
  border: 1rpx solid #7FCEBC;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.user-avatar-small {
  width: 80rpx;
  height: 80rpx;
  background: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.username {
  font-size: 32rpx;
  font-weight: bold;
  color: #0B6E56;
}

.protection-tag {
  font-size: 24rpx;
  font-weight: bold;
}

.user-actions {
  display: flex;
  gap: 16rpx;
}

.btn-action {
  flex: 1;
  padding: 20rpx;
  border-radius: 24rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: bold;
}

.btn-action.donate {
  background-color: #D4E5D9;
  color: #0B6E56;
}

.btn-action.attack {
  background-color: #FF6B9D;
  color: white;
}

.close-footer {
  padding: 40rpx;
  text-align: center;
  font-weight: 900;
  color: #0B6E56;
  letter-spacing: 2rpx;
}

/* ESCENA DE ATAQUE */
.view-atacar {
  position: absolute;
  inset: 0;
  background-color: #59A5C6;
  padding: 64rpx 40rpx;
  display: flex;
  flex-direction: column;
  z-index: 60;
}

.rival-info {
  text-align: center;
  margin-bottom: 64rpx;
}

.rival-name {
  font-size: 40rpx;
  font-weight: 900;
  color: white;
  text-shadow: 0 4rpx 8rpx rgba(0,0,0,0.2);
}

.rival-stats {
  font-size: 30rpx;
  color: #DAF7A6;
  font-weight: bold;
}

.battle-arena {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.enemy-fort {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.enemy-block {
  width: 140rpx;
  height: 140rpx;
  background: white;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  box-shadow: 0 12rpx 0 #CBD5E0;
  transition: all 0.1s;
}

.enemy-block:active {
  transform: translateY(8rpx) scale(0.9);
  background: #FF6B9D;
  box-shadow: 0 4rpx 0 #9B2C2C;
}

.attack-footer {
  padding: 40rpx;
  text-align: center;
}

.attack-hint {
  color: white;
  font-size: 24rpx;
  font-weight: bold;
  margin-bottom: 32rpx;
  display: block;
}

.exit-btn {
  background: white;
  color: #FF6B9D;
  padding: 32rpx;
  border-radius: 40rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.1);
}

/* ANIMATIONS */
@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}
.animate-pulse { animation: pulse 0.8s infinite; }

@keyframes floatMany {
  0% { transform: translate(-100rpx, -50rpx); }
  25% { transform: translate(100rpx, 50rpx); }
  50% { transform: translate(-50rpx, -80rpx); }
  75% { transform: translate(80rpx, 20rpx); }
  100% { transform: translate(0, 0); }
}
.animate-float { animation: floatMany 3s linear infinite; }

@keyframes wiggle {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-3deg); }
  75% { transform: rotate(3deg); }
}
.animate-wiggle { animation: wiggle 0.5s infinite; }

/* ── FUERTE DE TOKAYITO ── */
.fuerte-contenedor {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 500rpx;
  transform: translateY(-20rpx);
}

/* Superficie superior — el pasto */
.isla-superficie {
  width: 460rpx;
  height: 100rpx;
  background-color: #3D8B50;
  border-radius: 8rpx;
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

/* Píxeles decorativos del borde superior */
.pixel-deco {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  background-color: #4CAF50;
  top: -8rpx;
}
.pixel-deco-1 { left: 32rpx; }
.pixel-deco-2 { left: 96rpx; }
.pixel-deco-3 { right: 96rpx; }
.pixel-deco-4 { right: 32rpx; }

/* Plataforma donde irán los personajes */
.isla-plataforma {
  width: 440rpx;
  height: 180rpx;
  background-color: #2D7A40;
  border-radius: 4rpx;
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

/* Cuerpo de tierra */
.isla-tierra {
  width: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tierra-capa-1 {
  width: 440rpx;
  height: 28rpx;
  background-color: #8B6340;
}

.tierra-capa-2 {
  width: 380rpx;
  height: 22rpx;
  background-color: #6B4A28;
}

/* Picos de tierra colgando */
.tierra-picos {
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: 8rpx;
  margin-top: 4rpx;
}

.pico {
  width: 0;
  height: 0;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-top: 28rpx solid #4A3018;
}

.pico-1 { border-top-width: 20rpx; }
.pico-2 { border-top-width: 32rpx; }
.pico-3 { border-top-width: 40rpx; }
.pico-4 { border-top-width: 28rpx; }
.pico-5 { border-top-width: 18rpx; }

/* Sombra debajo de la isla */
.isla-sombra {
  width: 280rpx;
  height: 16rpx;
  background-color: rgba(0, 0, 0, 0.25);
  border-radius: 50%;
  margin-top: 12rpx;
}

.tokayito-wrapper {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  position: absolute;
  bottom: 0;
  left: 50%;
  margin-left: -140rpx;
  width: 280rpx;
  z-index: 2;
}

.tokayito-img {
  width: 280rpx;
  height: 280rpx;
  position: absolute;
  bottom: 0;
  left: 50%;
  margin-left: -140rpx;
  z-index: 2;
}

/* ── GRID DE JUGADORES ── */
.grid-jugadores {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-around;
  align-items: center;
  width: 750rpx;
  padding: 24rpx 32rpx;
  gap: 24rpx;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 300rpx;
}

/* Isla mini — superficie */
.isla-mini {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.isla-mini-superficie {
  width: 220rpx;
  height: 50rpx;
  background-color: #3D8B50;
  border-radius: 6rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  position: relative;
}

.isla-mini-plataforma {
  width: 200rpx;
  height: 36rpx;
  background-color: #2D7A40;
  border-radius: 4rpx;
}

/* Tierra mini */
.isla-mini-tierra {
  width: 220rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tierra-mini-capa-1 {
  width: 200rpx;
  height: 16rpx;
  background-color: #8B6340;
}

.tierra-mini-capa-2 {
  width: 170rpx;
  height: 14rpx;
  background-color: #6B4A28;
}

.tierra-mini-picos {
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: 6rpx;
  margin-top: 4rpx;
}

.pico-mini {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 18rpx solid #4A3018;
}

.pico-mini-1 { border-top-width: 14rpx; }
.pico-mini-2 { border-top-width: 22rpx; }
.pico-mini-3 { border-top-width: 16rpx; }

/* Sombra mini */
.isla-mini-sombra {
  width: 160rpx;
  height: 10rpx;
  background-color: rgba(0, 0, 0, 0.2);
  border-radius: 50%;
  margin-top: 8rpx;
}

/* Nombre del jugador */
.grid-jugador-nombre {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 12rpx;
  text-align: center;
}

/* ── BLOQUES DEL FUERTE ── */
.bloques-columna {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  gap: 8rpx;
  position: absolute;
  bottom: 0;
  z-index: 1;
}

.bloques-izquierda {
  left: 16rpx;
}

.bloques-derecha {
  right: 16rpx;
}

.bloque-wrapper {
  width: 72rpx;
  height: 72rpx;
}

.bloque-img {
  width: 72rpx;
  height: 72rpx;
}
