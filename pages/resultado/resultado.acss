.contenedor {
  width: 750rpx;
  min-height: 100vh;
  background-color: #071B45;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
}

.badge-record {
  background-color: #FFD700;
  border-radius: 40rpx;
  padding: 12rpx 36rpx;
  margin-bottom: 32rpx;
}

.badge-texto {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  font-weight: bold;
  color: #071B45;
}

.trofeo {
  margin-bottom: 40rpx;
}

.trofeo-emoji {
  font-size: 160rpx;
}

.bloque-puntos {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.bloque-record {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 64rpx;
}

.label {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 8rpx;
}

.valor-puntos {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  font-size: 120rpx;
  font-weight: bold;
  color: #00BCD4;
  line-height: 1;
}

.valor-record {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  font-size: 72rpx;
  font-weight: bold;
  color: #FFD700;
  line-height: 1;
}

.botones {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.btn-primario {
  width: 100%;
  height: 96rpx;
  background-color: #00BCD4;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 48rpx;
  border: none;
}

.btn-secundario {
  width: 100%;
  height: 96rpx;
  background-color: transparent;
  color: #ffffff;
  font-size: 32rpx;
  border-radius: 48rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}
