<view class="custom-header">
  <text class="header-texto">TIKI TOKA</text>
</view>

<view class="page-container">

  <view class="content">
    <!-- MAPA -->
    <view a:if="{{view === 'mapa'}}" class="map-view animate-fade-in">
      <text class="subtitle">Selecciona un bioma para jugar y ganar puntos.</text>
      
      <view class="map-card">
        <!-- Dots decorativos -->
        <view 
          a:for="{{dots}}" 
          class="dot" 
          style="top: {{item.top}}%; left: {{item.left}}%; animation-delay: {{item.delay}}s; animation-duration: {{item.duration}}s;"
        ></view>

      <view class="hex-grid">
        <view 
          a:for="{{biomas}}" 
          class="hex-item hex-{{item.id}}" 
          onTap="handleSeleccionarBioma" 
          data-id="{{item.id}}"
        >
          <view class="hex-shape" style="background: linear-gradient(135deg, {{item.color}}88 0%, {{item.color}} 100%);">
            <view class="hex-inner">
              <text class="hex-emoji">{{item.emoji}}</text>
              <text class="hex-label">{{item.nombre}}</text>
            </view>
          </view>
        </view>
      </view>
      </view>
    </view>

    <!-- MINIJUEGO -->
    <view a:if="{{view === 'minijuego'}}" class="minijuego-view animate-fade-in" style="background-color: {{biomaActivo.bgDark}}">
      <!-- Halo effect -->
      <view class="halo" style="background: radial-gradient(circle at 50% 40%, {{biomaActivo.color}}40 0%, transparent 65%)"></view>

      <view class="game-icon-box" style="background-color: {{biomaActivo.color}}22; border-color: {{biomaActivo.color}};">
        <text class="icon-large" style="color: {{biomaActivo.color}};">🎮</text>
      </view>

      <view class="info-box">
        <text class="bioma-title" style="color: {{biomaActivo.color}};">{{biomaActivo.nombre}}</text>
        <text class="bioma-desc">{{biomaActivo.descripcion}}</text>
        <text class="bioma-hint">(Simulador de minijuego en construcción)</text>
      </view>

      <button class="play-btn" style="background-color: {{biomaActivo.color}}22; border-color: {{biomaActivo.color}}; color: {{biomaActivo.color}};" onTap="setViewMapa">
        Jugar y ganar puntos
      </button>
    </view>
  </view>
</view>

<view style="height: 100px; width: 100%;"></view>

<view style="height: 100px; width: 100%;"></view>

<view class="custom-tab-bar">
  <view class="tab-item" onTap="goToTikitoka">
    <image class="tab-icon active" src="/assets/icons/tikitokaIcon.png" mode="aspectFit" />
    <text class="tab-text active">Tiki Toka</text>
  </view>
  
  <view class="tab-item" onTap="goToTokarena">
    <image class="tab-icon" src="/assets/icons/TokaArenaIcon.png" mode="aspectFit" />
    <text class="tab-text">Tokarena</text>
  </view>
  
  <view class="tab-item" onTap="goToTokayito">
    <image class="tab-icon" src="/assets/icons/tokayitoIcon.png" mode="aspectFit" />
    <text class="tab-text">Tokayito</text>
  </view>
  
  <view class="tab-item" onTap="goToTienda">
    <image class="tab-icon" src="/assets/icons/tiendaIcon.png" mode="aspectFit" />
    <text class="tab-text">Tienda</text>
  </view>
</view>