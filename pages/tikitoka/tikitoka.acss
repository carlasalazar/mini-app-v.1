.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.header {
  padding: 64rpx 40rpx 40rpx;
  background-color: transparent;
  border-bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header-left {
  display: flex;
  align-items: center;
}

.back-btn, .header-icon {
  margin-right: 16rpx;
}

.icon {
  font-size: 48rpx;
  color: var(--pink);
}

.title {
  font-size: 40rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}

.content {
  flex: 1;
  position: relative;
  overflow: hidden;
}

.map-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  height: 100%;
}

.subtitle {
  font-size: 24rpx;
  color: var(--grass-green);
  margin-bottom: 40rpx;
  text-align: center;
}

.map-card {
  width: 100%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
}

.dot {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  background-color: #00BCD4;
  border-radius: 50%;
  opacity: 0.2;
  animation: dotBlink 2s infinite;
}

@keyframes dotBlink {
  0%, 100% { opacity: 0.1; }
  50% { opacity: 0.4; }
}

.hex-grid {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 40rpx 0;
}

.hex-item {
  width: 350rpx;
  height: 300rpx;
  margin: 10rpx 0;
  position: relative;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.hex-item:active {
  transform: scale(0.92);
  z-index: 10;
}

.hex-shape {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent !important;
}

.hex-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.hex-emoji {
  width: 280rpx;
  height: 280rpx;
}



/* Offset positioning for honeycomb effect */
.hex-centro {
  margin-left: 160rpx;
}
.hex-sur {
  margin-left: -160rpx;
}

.minijuego-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  height: 100%;
  position: relative;
}

.halo {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.game-icon-box {
  width: 192rpx;
  height: 192rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
  border: 4rpx solid;
}

.icon-large {
  font-size: 88rpx;
}

.info-box {
  text-align: center;
  margin-bottom: 64rpx;
}

.bioma-title {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.bioma-desc {
  font-size: 28rpx;
  color: var(--teal-dark);
  margin-bottom: 8rpx;
}

.bioma-hint {
  font-size: 24rpx;
  opacity: 0.6;
}

.play-btn {
  width: 100%;
  max-width: 600rpx;
  padding: 24rpx 0;
  border-radius: 24rpx;
  font-weight: bold;
  border: 4rpx solid #FFFFFF;
  font-size: 32rpx;
  background-color: var(--pink);
  color: #FFFFFF;
  box-shadow: 0 10rpx 30rpx rgba(255, 107, 157, 0.3);
}
