.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  position: relative;
  overflow: hidden;
}

.sparkles-container {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}

.sparkle {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  opacity: 0;
  animation: sparkleAnim infinite;
}

@keyframes sparkleAnim {
  0% { opacity: 0; transform: scale(0) translateY(0); }
  50% { opacity: 0.8; transform: scale(1.2) translateY(-20rpx); }
  100% { opacity: 0; transform: scale(0) translateY(-40rpx); }
}

.header {
  padding: 80rpx 48rpx 32rpx;
  z-index: 10;
}

.page-title {
  font-size: 72rpx;
  font-weight: 900;
  letter-spacing: -4rpx;
  color: var(--teal-dark);
  text-shadow: 0 8rpx 0 #FFFFFF;
}

.main-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  z-index: 10;
}

.island-container {
  position: relative;
  width: 100%;
  max-width: 640rpx;
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.island-base {
  position: absolute;
  bottom: 0;
  width: 95%;
  height: 45%;
  border-radius: 50%;
  border: 8rpx dashed;
  background-color: rgba(255,255,255,0.4);
  box-shadow: 0 30rpx 60rpx rgba(11, 110, 86, 0.15);
}

.avatar-card {
  position: relative;
  z-index: 20;
  width: 352rpx;
  height: 352rpx;
  border-radius: 80rpx;
  background-color: var(--glass);
  backdrop-filter: blur(10px);
  border: 8rpx solid #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 40rpx 80rpx rgba(11, 110, 86, 0.1);
}

.avatar-label {
  font-size: 22rpx;
  font-weight: 900;
  opacity: 0.4;
  margin-bottom: 16rpx;
}

.avatar-emoji {
  font-size: 120rpx;
}

.trivia-btn {
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--pink);
  border: 8rpx solid #FFFFFF;
  box-shadow: 0 16rpx 32rpx rgba(0,0,0,0.1);
}

.icon-help {
  font-size: 48rpx;
  color: #FFFFFF;
}

.stats-card {
  width: 100%;
  max-width: 680rpx;
  margin-top: 50rpx;
  padding: 20rpx;
  border-radius: 70rpx;
  background-color: var(--glass);
  backdrop-filter: blur(10px);
  border: 8rpx solid #FFFFFF;
  display: flex;
  gap: 40rpx;
  align-items: center;
  box-shadow: 0 30rpx 70rpx rgba(11, 110, 86, 0.08);
}

.perfection-ring-box {
  width: 224rpx;
  height: 224rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.aura {
  position: absolute;
  inset: 0;
  border-radius: 50%;
}

.ring-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 20;
}

.ring-value {
  font-size: 80rpx;
  font-weight: 900;
}

.ring-label {
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.ring-border {
  position: absolute;
  inset: 16rpx;
  border-radius: 50%;
  border: 16rpx solid;
  opacity: 0.5;
}

.bars-container {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.stat-item {
  margin-bottom: 24rpx;
}

.stat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.stat-value {
  font-size: 28rpx;
  font-weight: 900;
}

.bar-bg {
  width: 100%;
  height: 32rpx;
  border-radius: 32rpx;
  background-color: rgba(255,255,255,0.4);
  border: 4rpx solid #FFFFFF;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 32rpx;
  position: relative;
  transition: width 1.2s ease-out;
}

.bar-fill::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 50%;
  background-color: rgba(255,255,255,0.4);
  border-radius: 32rpx;
}

/* MODAL */
.modal-overlay {
  position: absolute;
  inset: 0;
  background-color: rgba(11, 110, 86, 0.4);
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}

.modal-content {
  width: 100%;
  max-width: 640rpx;
  border-radius: 80rpx;
  padding: 64rpx;
  position: relative;
  background-color: #FFFFFF;
  border: 8rpx solid var(--teal-light);
  box-shadow: 0 80rpx 120rpx rgba(11, 110, 86, 0.2);
}

.close-btn {
  position: absolute;
  top: 40rpx;
  right: 40rpx;
  padding: 16rpx;
}

.trivia-start, .trivia-playing, .trivia-result {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-icon {
  font-size: 140rpx;
  margin-bottom: 32rpx;
}

.step-title {
  font-size: 48rpx;
  font-weight: 900;
  margin-bottom: 24rpx;
  text-align: center;
}

.step-desc {
  font-size: 32rpx;
  text-align: center;
  margin-bottom: 64rpx;
}

.primary-btn {
  width: 100%;
  padding: 32rpx 0;
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--pink);
  box-shadow: 0 20rpx 40rpx rgba(255, 107, 157, 0.3);
}

.primary-btn text {
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 900;
}

.q-progress {
  font-size: 24rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  color: #7FCEBC;
  margin-bottom: 32rpx;
}

.q-text {
  font-size: 40rpx;
  font-weight: 900;
  text-align: center;
  margin-bottom: 48rpx;
}

.options-list {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.option-item {
  padding: 32rpx;
  border-radius: 32rpx;
  border: 4rpx solid;
  font-size: 28rpx;
  font-weight: bold;
}

.badge {
  padding: 16rpx 48rpx;
  border-radius: 100rpx;
  border: 4rpx solid;
  font-weight: 900;
  margin-bottom: 64rpx;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}
.animate-float { animation: float 4s ease-in-out infinite; }
.animate-float-delayed { animation: float 4s ease-in-out 0.5s infinite; }

@keyframes wiggle {
  0%, 100% { transform: rotate(0); }
  25% { transform: rotate(10deg); }
  75% { transform: rotate(-10deg); }
}
.animate-wiggle { animation: wiggle 2s infinite; }

@keyframes popIn {
  from { transform: scale(0.8) translateY(100rpx); opacity: 0; }
  to { transform: scale(1) translateY(0); opacity: 1; }
}
.animate-pop-in { animation: popIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }
