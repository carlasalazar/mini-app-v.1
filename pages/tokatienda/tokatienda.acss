.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* HEADER */
.header {
  padding: 80rpx 40rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  background-color: transparent;
  border-bottom: 0;
  z-index: 30;
}

.store-title {
  font-size: 56rpx;
  font-weight: 900;
  letter-spacing: -3rpx;
  text-shadow: 0 4rpx 0 #FFF;
}

.points-bubble {
  position: absolute;
  top: 90rpx;
  right: 32rpx;
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
  background-color: var(--soft-yellow);
  border-radius: 40rpx;
  border: 4rpx solid var(--teal-dark);
  box-shadow: 0 8rpx 16rpx rgba(11, 110, 86, 0.1);
  transform: rotate(2deg);
}

.points-icon { font-size: 28rpx; margin-right: 8rpx; }
.points-count { font-size: 28rpx; font-weight: 900; }

/* SCROLL AREA */
.main-scroll { flex: 1; }

/* PREVIEW SECTION */
.preview-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
}

.island-base {
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  border: 8rpx dashed var(--teal-light);
  background-color: var(--glass);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: 0 20rpx 60rpx rgba(11, 110, 86, 0.1);
}

.avatar-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.avatar-mascot { font-size: 140rpx; }

.overlay-hat {
  position: absolute;
  top: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 100rpx;
  z-index: 5;
}

.overlay-acc {
  position: absolute;
  bottom: 0;
  right: -20rpx;
  font-size: 80rpx;
  z-index: 10;
}

.preview-hint {
  margin-top: 24rpx;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  opacity: 0.6;
}

/* TABS */
.tabs-container {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  padding: 0 32rpx 48rpx;
}

.tab-item {
  padding: 20rpx 32rpx;
  border-radius: 100rpx;
  font-size: 26rpx;
  font-weight: 900;
  transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.tab-item.active {
  transform: scale(1.08);
  box-shadow: 0 12rpx 24rpx rgba(0,0,0,0.1);
}

/* GRID */
.catalog-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  padding: 0 32rpx 64rpx;
}

.item-card {
  width: calc(50% - 12rpx);
  border-radius: 56rpx;
  padding: 40rpx 32rpx;
  border: 4rpx solid var(--white);
  display: flex;
  flex-direction: column;
  top: 0;
  align-items: center;
  box-shadow: 0 12rpx 32rpx rgba(11, 110, 86, 0.08);
  background-color: var(--glass) !important;
  backdrop-filter: blur(5px);
}

.item-visual-box {
  width: 144rpx;
  height: 144rpx;
  border-radius: 40rpx;
  background-color: #FFF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  position: relative;
}

.item-emoji { font-size: 80rpx; }

.new-tag {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  padding: 4rpx 12rpx;
  border-radius: 100rpx;
  color: #FFF;
  font-size: 16rpx;
  font-weight: 900;
}

.item-details { text-align: center; margin-bottom: 32rpx; }
.item-name { font-size: 26rpx; font-weight: 900; margin-bottom: 4rpx; }
.item-meta { font-size: 20rpx; opacity: 0.5; font-weight: bold; }

.item-footer { width: 100%; }

.price-btn {
  width: 100%;
  padding: 16rpx 0;
  border-radius: 100rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: var(--pink);
}

.owned-badge text, .price-btn text {
  font-size: 24rpx;
  font-weight: 900;
}

/* MODAL */
.modal-overlay {
  position: absolute;
  inset: 0;
  background-color: rgba(11, 110, 86, 0.4);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.modal-content {
  width: 100%;
  max-width: 600rpx;
  border-radius: 80rpx;
  padding: 64rpx;
  background-color: var(--white);
  border: 8rpx solid var(--teal-light);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 80rpx 120rpx rgba(11, 110, 86, 0.15);
}

.modal-title { font-size: 40rpx; font-weight: 900; margin-bottom: 48rpx; }

.modal-item-preview {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.modal-emoji { font-size: 120rpx; margin-bottom: 16rpx; }
.modal-name { font-size: 32rpx; font-weight: bold; }
.modal-price { font-size: 48rpx; font-weight: 900; margin-bottom: 64rpx; }

.modal-actions {
  width: 100%;
  display: flex;
  gap: 24rpx;
}

.btn-cancel, .btn-confirm {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 100rpx;
  text-align: center;
  font-weight: 900;
  font-size: 32rpx;
}

.btn-cancel { background-color: #EEE; color: #666; }
.btn-confirm { color: #FFF; }

/* ANIMATIONS */
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}
.animate-float { animation: float 4s ease-in-out infinite; }

@keyframes popIn {
  from { transform: scale(0.8); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}
.animate-pop-in { animation: popIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }

.bottom-padding { height: 120rpx; }
